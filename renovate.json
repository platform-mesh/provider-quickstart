{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>platform-mesh/.github:renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/multicluster-runtime"
      ],
      "allowedVersions": "<0.25.0"
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apimachinery",
        "k8s.io/client-go",
        "k8s.io/apiextensions-apiserver"
      ],
      "allowedVersions": "<0.37.0"
    }
  ]
}
